# Gitignore settings for ESPHome
# This is an example and may include too much for your use-case.
# You can modify this file to suit your needs.
# esphome のビルドキャッシュ（config/ 配下でも生成されるため場所固定にしない）
.esphome/
/config/secrets.yaml
# esphome が config/ 配下に自動生成する .gitignore（root の本ファイルで代替済み）
/config/.gitignore

# 生成物（dashboard.py の出力）
/dist/

# playwright-cli セッション残骸
/.playwright-cli/

# Python
__pycache__/
*.pyc

# superpowers スキルの作業ファイル（成果物ではない）
/docs/superpowers/
