# secrets.yaml.example — このファイルをコピーして secrets.yaml を作り、値を埋める
#   cp secrets.yaml.example secrets.yaml
# secrets.yaml は .gitignore 済み（コミットしない）。このサンプルには実値を書かない。

# --- WiFi（2.4GHz必須。ESP32-C3は5GHz非対応）---
wifi_ssid: "YOUR_WIFI_SSID"
wifi_password: "YOUR_WIFI_PASSWORD"

# --- フォールバックAP（接続失敗時に現地設定変更用。8文字以上）---
fallback_ap_password: "YOUR_FALLBACK_AP_PASSWORD"

# --- OTA（無線ファーム更新のパスワード）---
ota_password: "YOUR_OTA_PASSWORD"

# --- InfluxDB 書き込み ---
# write URL: org / bucket / precision を自分の環境に合わせる
influx_write_url: "https://<region>.aws.cloud2.influxdata.com/api/v2/write?org=<ORG_ID>&bucket=office_env&precision=s"
# 書き込み権限トークン（device専用。write権限のみのトークン推奨）
influx_auth_header: "Token <YOUR_INFLUXDB_WRITE_TOKEN>"

# --- InfluxDB 読み取り（scripts/dashboard.py のクエリ用）---
# 読み取り権限トークン（write とは別に発行推奨）。環境変数 INFLUX_TOKEN でも可（そちら優先）
# 当面 write と同じ r/w トークンを使い回してもよい（後でスコープ分離できるよう定義だけ分けてある）
influx_read_token: "<YOUR_INFLUXDB_READ_TOKEN>"

# --- InfluxDB ダッシュボード適用（scripts/apply_dashboard.py 用）---
# ダッシュボードの読み書き権限を持つトークン（write トークンとは別に発行推奨）
# 環境変数 INFLUX_DASHBOARD_TOKEN でも指定可（そちらが優先）
influx_dashboard_token: "<YOUR_INFLUXDB_DASHBOARD_TOKEN>"
