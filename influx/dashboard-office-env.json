[
  {
    "apiVersion": "influxdata.com/v2alpha1",
    "kind": "Dashboard",
    "metadata": { "name": "office-env-multi" },
    "spec": {
      "name": "Office Env — 全台横断",
      "description": "環境メトリックを device 別多系列で表示。device 固定フィルタなし=台数自動スケール。",
      "charts": [
        {
          "kind": "Xy",
          "name": "CO2 (ppm)",
          "xPos": 0, "yPos": 0, "width": 6, "height": 4,
          "position": "overlaid",
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "hoverDimension": "auto",
          "legendColorizeRows": true,
          "queries": [
            { "query": "from(bucket: \"office_env\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"co2\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])" }
          ],
          "axes": [
            { "name": "x", "base": "10", "scale": "linear" },
            { "name": "y", "base": "10", "scale": "linear", "label": "ppm" }
          ],
          "colors": [
            { "type": "scale", "hex": "#31C0F6" },
            { "type": "scale", "hex": "#A500A5" },
            { "type": "scale", "hex": "#FF7E27" }
          ]
        },
        {
          "kind": "Xy",
          "name": "気温 (°C)",
          "xPos": 6, "yPos": 0, "width": 6, "height": 4,
          "position": "overlaid",
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "hoverDimension": "auto",
          "legendColorizeRows": true,
          "queries": [
            { "query": "from(bucket: \"office_env\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"temp\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])" }
          ],
          "axes": [
            { "name": "x", "base": "10", "scale": "linear" },
            { "name": "y", "base": "10", "scale": "linear", "label": "°C" }
          ],
          "colors": [
            { "type": "scale", "hex": "#31C0F6" },
            { "type": "scale", "hex": "#A500A5" },
            { "type": "scale", "hex": "#FF7E27" }
          ]
        },
        {
          "kind": "Xy",
          "name": "湿度 (%)",
          "xPos": 0, "yPos": 4, "width": 6, "height": 4,
          "position": "overlaid",
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "hoverDimension": "auto",
          "legendColorizeRows": true,
          "queries": [
            { "query": "from(bucket: \"office_env\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"rh\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])" }
          ],
          "axes": [
            { "name": "x", "base": "10", "scale": "linear" },
            { "name": "y", "base": "10", "scale": "linear", "label": "%" }
          ],
          "colors": [
            { "type": "scale", "hex": "#31C0F6" },
            { "type": "scale", "hex": "#A500A5" },
            { "type": "scale", "hex": "#FF7E27" }
          ]
        },
        {
          "kind": "Xy",
          "name": "VOC (index)",
          "xPos": 6, "yPos": 4, "width": 6, "height": 4,
          "position": "overlaid",
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "hoverDimension": "auto",
          "legendColorizeRows": true,
          "queries": [
            { "query": "from(bucket: \"office_env\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"voc\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])" }
          ],
          "axes": [
            { "name": "x", "base": "10", "scale": "linear" },
            { "name": "y", "base": "10", "scale": "linear", "label": "index" }
          ],
          "colors": [
            { "type": "scale", "hex": "#31C0F6" },
            { "type": "scale", "hex": "#A500A5" },
            { "type": "scale", "hex": "#FF7E27" }
          ]
        },
        {
          "kind": "Xy",
          "name": "騒音 LAeq (dB)",
          "xPos": 0, "yPos": 8, "width": 12, "height": 4,
          "position": "overlaid",
          "geom": "line",
          "xCol": "_time",
          "yCol": "_value",
          "hoverDimension": "auto",
          "legendColorizeRows": true,
          "queries": [
            { "query": "from(bucket: \"office_env\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"env\" and r._field == \"laeq\")\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)\n  |> group(columns: [\"device\"])" }
          ],
          "axes": [
            { "name": "x", "base": "10", "scale": "linear" },
            { "name": "y", "base": "10", "scale": "linear", "label": "dB" }
          ],
          "colors": [
            { "type": "scale", "hex": "#31C0F6" },
            { "type": "scale", "hex": "#A500A5" },
            { "type": "scale", "hex": "#FF7E27" }
          ]
        }
      ]
    }
  }
]
